[Unit]
Description=ReSourcer API Server
After=network.target

[Service]
Type=simple

# ====== 按实际环境修改以下路径 ======
# 二进制文件路径（程序目录，NAS 系统更新可能整体清空重装，不要放数据）
ExecStart=/opt/re-sourcer/re-sourcer
WorkingDirectory=/opt/re-sourcer
Environment=HOME=/opt/re-sourcer
# 持久化数据目录（sqlite/、config/、backups/）：必须指向一个不会被系统更新清空的
# 卷，例如群晖 /volume1/docker/re-sourcer 或 QNAP /share/re-sourcer-data。
# 不设置时行为与旧版一致——数据仍会落在 WorkingDirectory 下，随程序目录一起被清空。
Environment=RESOURCER_DATA_DIR=/change/me/to/a/persistent/volume
# ====================================

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
